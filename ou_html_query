#!/usr/bin/env python3

import boto3
import urllib.parse
from datetime import datetime
from collections import defaultdict
import html


# ==========================================================
# Configuration
# ==========================================================

ROLE_NAME = "OrganizationAccountAccessRole"

OUTPUT_FILE = "aws_organization_inventory.html"


# ==========================================================
# AWS Session
# Uses default credentials
# ==========================================================

session = boto3.Session()

org = session.client("organizations")


# ==========================================================
# Organization Functions
# ==========================================================

def get_root_id():

    return org.list_roots()["Roots"][0]["Id"]



def list_ous(parent_id):

    paginator = org.get_paginator(
        "list_organizational_units_for_parent"
    )

    ous = []

    for page in paginator.paginate(
        ParentId=parent_id
    ):

        ous.extend(
            page["OrganizationalUnits"]
        )

    return ous



def list_accounts(parent_id):

    paginator = org.get_paginator(
        "list_accounts_for_parent"
    )

    accounts = []

    for page in paginator.paginate(
        ParentId=parent_id
    ):

        accounts.extend(
            page["Accounts"]
        )

    return accounts



# ==========================================================
# Inventory Collection
# ==========================================================

accounts = []


def walk(parent_id, path):

    for acct in list_accounts(parent_id):

        switch_url = (
            "https://signin.aws.amazon.com/switchrole?"
            f"account={acct['Id']}"
            f"&roleName={urllib.parse.quote(ROLE_NAME)}"
            f"&displayName={urllib.parse.quote(acct['Name'])}"
        )


        accounts.append(
            {
                "name": acct["Name"],
                "id": acct["Id"],
                "ou": path,
                "status": acct["Status"],
                "url": switch_url,
            }
        )


    for ou in list_ous(parent_id):

        walk(
            ou["Id"],
            f"{path}/{ou['Name']}"
        )



print("Collecting AWS Organization accounts...")

walk(
    get_root_id(),
    "Root"
)


accounts.sort(
    key=lambda x: (
        x["ou"],
        x["name"]
    )
)


print(
    f"Found {len(accounts)} accounts"
)



# ==========================================================
# Group By OU
# ==========================================================

grouped = defaultdict(list)

for account in accounts:

    grouped[
        account["ou"]
    ].append(account)



# ==========================================================
# HTML Generation
# ==========================================================

generated = datetime.utcnow().strftime(
    "%Y-%m-%d %H:%M UTC"
)


with open(
    OUTPUT_FILE,
    "w",
    encoding="utf-8"
) as f:


    f.write(
f"""
<!DOCTYPE html>
<html>

<head>

<title>AWS Organization Inventory</title>


<style>

body {{
    font-family: Arial, Helvetica, sans-serif;
    margin: 40px;
    background: #f5f6f8;
    color: #222;
}}


h1 {{
    color: #232f3e;
}}


.summary {{
    background: white;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 25px;
    box-shadow: 0 2px 5px #ccc;
}}


input {{
    width: 400px;
    padding: 10px;
    font-size: 16px;
    margin-bottom:20px;
}}


details {{

    background:white;
    margin-bottom:15px;
    padding:15px;
    border-radius:8px;
    box-shadow:0 1px 4px #ccc;

}}


summary {{

    font-size:18px;
    font-weight:bold;
    cursor:pointer;

}}


.account {{

    margin-left:25px;
    padding:15px;
    border-top:1px solid #ddd;

}}


.account-name {{

    font-size:17px;
    font-weight:bold;

}}


.account-id {{

    font-family:monospace;

}}


.button {{

    display:inline-block;
    margin-top:10px;
    padding:8px 14px;
    background:#146eb4;
    color:white;
    text-decoration:none;
    border-radius:5px;

}}


.button:hover {{

    background:#0f4f82;

}}


.hidden {{

    display:none;

}}

</style>


<script>

function searchAccounts() {{

    let input =
        document.getElementById(
            "search"
        ).value.toLowerCase();


    let accounts =
        document.getElementsByClassName(
            "account"
        );


    for (
        let i = 0;
        i < accounts.length;
        i++
    ) {{

        let text =
            accounts[i]
            .innerText
            .toLowerCase();


        if (
            text.includes(input)
        ) {{

            accounts[i]
            .classList
            .remove(
                "hidden"
            );

        }}

        else {{

            accounts[i]
            .classList
            .add(
                "hidden"
            );

        }}

    }}

}}

</script>


</head>


<body>


<h1>
AWS Organization Account Inventory
</h1>


<div class="summary">

<b>Generated:</b>
{generated}
<br><br>

<b>Total Accounts:</b>
{len(accounts)}

</div>



<input
id="search"
type="text"
placeholder="Search account, ID, or OU..."
onkeyup="searchAccounts()"
>


"""
)


    for ou, acct_list in grouped.items():


        f.write(
            f"""
<details open>

<summary>
{html.escape(ou)}
({len(acct_list)} accounts)
</summary>

"""
        )


        for acct in acct_list:


            f.write(
f"""

<div class="account">


<div class="account-name">
{html.escape(acct['name'])}
</div>


<br>


<b>Account ID:</b>

<span class="account-id">
{acct['id']}
</span>


<br><br>


<b>Status:</b>
{acct['status']}


<br>


<a
class="button"
href="{acct['url']}"
target="_blank">

Open AWS Console

</a>


</div>


"""
            )


        f.write(
            "</details>"
        )



    f.write(
"""
</body>

</html>
"""
    )



print()
print(
    f"Created HTML report:"
)

print(
    OUTPUT_FILE
)
