#!/usr/bin/env python3

import boto3
from botocore.exceptions import ClientError

# ==========================================================
# Configuration
# ==========================================================

# Role to assume in each member account
ROLE_NAME = "OrganizationAccountAccessRole"

# Regions to inventory
REGIONS = [
    "us-east-1",
    "us-east-2",
    "ap-south-1",
    "ap-southeast-1",
    "us-west-2",
]

# Uses your default AWS credentials/profile (~/.aws/credentials)
session = boto3.Session()

org = session.client("organizations")
sts = session.client("sts")


# ==========================================================
# Organizations
# ==========================================================

def list_accounts():
    paginator = org.get_paginator("list_accounts")

    accounts = []

    for page in paginator.paginate():
        for account in page["Accounts"]:
            if account["Status"] == "ACTIVE":
                accounts.append(account)

    return sorted(accounts, key=lambda x: x["Name"])


# ==========================================================
# STS Assume Role
# ==========================================================

def assume_role(account_id):

    response = sts.assume_role(
        RoleArn=f"arn:aws:iam::{account_id}:role/{ROLE_NAME}",
        RoleSessionName="VpcInventory",
    )

    creds = response["Credentials"]

    return boto3.Session(
        aws_access_key_id=creds["AccessKeyId"],
        aws_secret_access_key=creds["SecretAccessKey"],
        aws_session_token=creds["SessionToken"],
    )


# ==========================================================
# Helpers
# ==========================================================

def get_name_tag(tags):

    if not tags:
        return ""

    for tag in tags:
        if tag["Key"] == "Name":
            return tag["Value"]

    return ""


# ==========================================================
# Main
# ==========================================================

accounts = list_accounts()

print()
print(f"Found {len(accounts)} active accounts.")
print()

for account in accounts:

    print("=" * 120)
    print(f"{account['Name']} ({account['Id']})")
    print("=" * 120)

    try:
        acct_session = assume_role(account["Id"])

    except ClientError as e:
        print(f"\nERROR assuming role:")
        print(f"  {e}")
        print()
        continue

    found_any = False

    for region in REGIONS:

        try:
            ec2 = acct_session.client("ec2", region_name=region)

            response = ec2.describe_vpcs()

            vpcs = response["Vpcs"]

        except ClientError as e:
            print(f"\n[{region}] ERROR: {e.response['Error']['Code']}")
            continue

        if not vpcs:
            continue

        found_any = True

        print(f"\n[{region}]")
        print("-" * 80)

        for vpc in sorted(vpcs, key=lambda v: v["VpcId"]):

            vpc_name = get_name_tag(vpc.get("Tags"))

            print()

            if vpc_name:
                print(f"VPC Name : {vpc_name}")

            print(f"VPC ID   : {vpc['VpcId']}")
            print(f"State    : {vpc['State']}")
            print(f"Default  : {vpc['IsDefault']}")

            print("IPv4 CIDRs:")

            for assoc in vpc.get("CidrBlockAssociationSet", []):
                print(f"   - {assoc['CidrBlock']}")

            ipv6 = [
                assoc["Ipv6CidrBlock"]
                for assoc in vpc.get("Ipv6CidrBlockAssociationSet", [])
                if assoc.get("Ipv6CidrBlock")
            ]

            if ipv6:
                print("IPv6 CIDRs:")
                for cidr in ipv6:
                    print(f"   - {cidr}")

    if not found_any:
        print("\nNo VPCs found in configured regions.")

    print()
