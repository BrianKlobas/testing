#!/usr/bin/env python3

import boto3
from botocore.exceptions import ClientError
from openpyxl import Workbook
from openpyxl.utils import get_column_letter
from datetime import datetime


# ==========================================================
# Configuration
# ==========================================================

ROLE_NAME = "OrganizationAccountAccessRole"

REGIONS = [
    "us-east-1",
    "us-east-2",
    "ap-south-1",
    "ap-southeast-1",
    "us-west-2",
]

OUTPUT_FILE = "aws_vpc_cidr_inventory.xlsx"


# Uses default AWS credentials/profile
session = boto3.Session()

org = session.client("organizations")
sts = session.client("sts")


# ==========================================================
# Organizations
# ==========================================================

def list_accounts():

    paginator = org.get_paginator("list_accounts")

    accounts = []

    for page in paginator.paginate():
        for account in page["Accounts"]:
            if account["Status"] == "ACTIVE":
                accounts.append(account)

    return sorted(accounts, key=lambda x: x["Name"])


# ==========================================================
# Assume Role
# ==========================================================

def assume_role(account_id):

    response = sts.assume_role(
        RoleArn=f"arn:aws:iam::{account_id}:role/{ROLE_NAME}",
        RoleSessionName="VpcCIDRInventory",
    )

    creds = response["Credentials"]

    return boto3.Session(
        aws_access_key_id=creds["AccessKeyId"],
        aws_secret_access_key=creds["SecretAccessKey"],
        aws_session_token=creds["SessionToken"],
    )


# ==========================================================
# Helpers
# ==========================================================

def get_name_tag(tags):

    if not tags:
        return ""

    for tag in tags:
        if tag["Key"] == "Name":
            return tag["Value"]

    return ""


# ==========================================================
# Excel Setup
# ==========================================================

wb = Workbook()

ws = wb.active
ws.title = "VPC CIDR Inventory"

headers = [
    "Account Name",
    "Account ID",
    "Region",
    "VPC Name",
    "VPC ID",
    "CIDR Version",
    "CIDR",
    "VPC State",
    "Default VPC",
]

ws.append(headers)


# ==========================================================
# Inventory
# ==========================================================

accounts = list_accounts()

print(f"Scanning {len(accounts)} accounts...\n")


for account in accounts:

    print("=" * 100)
    print(f"{account['Name']} ({account['Id']})")
    print("=" * 100)

    try:
        acct_session = assume_role(account["Id"])

    except ClientError as e:
        print(f"FAILED ROLE ASSUME: {e}")
        continue


    for region in REGIONS:

        try:

            ec2 = acct_session.client(
                "ec2",
                region_name=region
            )

            vpcs = ec2.describe_vpcs()["Vpcs"]

        except ClientError as e:
            print(
                f"{region}: "
                f"{e.response['Error']['Code']}"
            )
            continue


        for vpc in vpcs:

            vpc_name = get_name_tag(
                vpc.get("Tags")
            )


            # IPv4 CIDRs
            for cidr in vpc.get(
                "CidrBlockAssociationSet",
                []
            ):

                ws.append([
                    account["Name"],
                    account["Id"],
                    region,
                    vpc_name,
                    vpc["VpcId"],
                    "IPv4",
                    cidr["CidrBlock"],
                    vpc["State"],
                    vpc["IsDefault"],
                ])

                print(
                    f"{region} "
                    f"{vpc['VpcId']} "
                    f"{cidr['CidrBlock']}"
                )


            # IPv6 CIDRs
            for cidr in vpc.get(
                "Ipv6CidrBlockAssociationSet",
                []
            ):

                if cidr.get("Ipv6CidrBlock"):

                    ws.append([
                        account["Name"],
                        account["Id"],
                        region,
                        vpc_name,
                        vpc["VpcId"],
                        "IPv6",
                        cidr["Ipv6CidrBlock"],
                        vpc["State"],
                        vpc["IsDefault"],
                    ])


# ==========================================================
# Formatting
# ==========================================================

for column in ws.columns:

    max_length = 0

    column_letter = get_column_letter(
        column[0].column
    )

    for cell in column:
        if cell.value:
            max_length = max(
                max_length,
                len(str(cell.value))
            )

    ws.column_dimensions[
        column_letter
    ].width = max_length + 3


# Add metadata sheet
meta = wb.create_sheet("Metadata")

meta.append([
    "Generated",
    datetime.utcnow().isoformat()
])

meta.append([
    "Regions",
    ", ".join(REGIONS)
])

meta.append([
    "Role Used",
    ROLE_NAME
])


wb.save(OUTPUT_FILE)

print()
print(f"Inventory saved: {OUTPUT_FILE}")
