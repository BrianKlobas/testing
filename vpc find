#!/usr/bin/env python3

import boto3
from botocore.exceptions import ClientError
from openpyxl import Workbook
from openpyxl.utils import get_column_letter
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime
import threading


# ==========================================================
# Configuration
# ==========================================================

ROLE_NAME = "OrganizationAccountAccessRole"

REGIONS = [
    "us-east-1",
    "us-east-2",
    "ap-south-1",
    "ap-southeast-1",
    "us-west-2",
]

OUTPUT_FILE = "aws_vpc_cidr_inventory.xlsx"

# Tune this
MAX_WORKERS = 25


# ==========================================================
# AWS clients
# ==========================================================

session = boto3.Session()

org = session.client("organizations")
sts = session.client("sts")


# ==========================================================
# Thread-safe counters
# ==========================================================

lock = threading.Lock()

completed = 0


# ==========================================================
# Organization
# ==========================================================

def list_accounts():

    paginator = org.get_paginator(
        "list_accounts"
    )

    accounts = []

    for page in paginator.paginate():

        for account in page["Accounts"]:

            if account["Status"] == "ACTIVE":
                accounts.append(account)

    return accounts



# ==========================================================
# Assume Role
# ==========================================================

def assume_role(account_id):

    response = sts.assume_role(
        RoleArn=f"arn:aws:iam::{account_id}:role/{ROLE_NAME}",
        RoleSessionName="VpcInventory",
    )

    creds = response["Credentials"]

    return boto3.Session(
        aws_access_key_id=creds["AccessKeyId"],
        aws_secret_access_key=creds["SecretAccessKey"],
        aws_session_token=creds["SessionToken"],
    )


# ==========================================================
# Helpers
# ==========================================================

def get_name_tag(tags):

    if not tags:
        return ""

    for tag in tags:
        if tag["Key"] == "Name":
            return tag["Value"]

    return ""



# ==========================================================
# Worker
# ==========================================================

def scan_account(account):

    global completed

    rows = []

    try:

        acct_session = assume_role(
            account["Id"]
        )


        for region in REGIONS:

            try:

                ec2 = acct_session.client(
                    "ec2",
                    region_name=region
                )

                vpcs = ec2.describe_vpcs()["Vpcs"]


                for vpc in vpcs:

                    vpc_name = get_name_tag(
                        vpc.get("Tags")
                    )


                    for cidr in vpc.get(
                        "CidrBlockAssociationSet",
                        []
                    ):

                        rows.append([
                            account["Name"],
                            account["Id"],
                            region,
                            vpc_name,
                            vpc["VpcId"],
                            "IPv4",
                            cidr["CidrBlock"],
                            vpc["State"],
                            vpc["IsDefault"],
                        ])



                    for cidr in vpc.get(
                        "Ipv6CidrBlockAssociationSet",
                        []
                    ):

                        if cidr.get(
                            "Ipv6CidrBlock"
                        ):

                            rows.append([
                                account["Name"],
                                account["Id"],
                                region,
                                vpc_name,
                                vpc["VpcId"],
                                "IPv6",
                                cidr["Ipv6CidrBlock"],
                                vpc["State"],
                                vpc["IsDefault"],
                            ])


            except ClientError:
                continue


    except Exception as e:

        rows.append([
            account["Name"],
            account["Id"],
            "ERROR",
            "",
            "",
            "",
            str(e),
            "",
            "",
        ])



    with lock:
        completed += 1
        print(
            f"[{completed}/{TOTAL_ACCOUNTS}] "
            f"{account['Name']}"
        )


    return rows



# ==========================================================
# Main
# ==========================================================

accounts = list_accounts()

TOTAL_ACCOUNTS = len(accounts)

print(
    f"Scanning {TOTAL_ACCOUNTS} accounts "
    f"with {MAX_WORKERS} workers..."
)


all_rows = []


with ThreadPoolExecutor(
    max_workers=MAX_WORKERS
) as executor:

    futures = [
        executor.submit(
            scan_account,
            account
        )
        for account in accounts
    ]


    for future in as_completed(futures):

        result = future.result()

        all_rows.extend(result)



# ==========================================================
# Write Excel
# ==========================================================

wb = Workbook()

ws = wb.active
ws.title = "VPC CIDR Inventory"


headers = [
    "Account Name",
    "Account ID",
    "Region",
    "VPC Name",
    "VPC ID",
    "CIDR Version",
    "CIDR",
    "VPC State",
    "Default VPC",
]


ws.append(headers)


for row in all_rows:
    ws.append(row)



for column in ws.columns:

    length = max(
        len(str(cell.value))
        if cell.value
        else 0
        for cell in column
    )

    ws.column_dimensions[
        get_column_letter(column[0].column)
    ].width = length + 3



meta = wb.create_sheet("Metadata")

meta.append([
    "Generated",
    datetime.utcnow().isoformat()
])

meta.append([
    "Accounts Scanned",
    TOTAL_ACCOUNTS
])

meta.append([
    "Regions",
    ",".join(REGIONS)
])


wb.save(
    OUTPUT_FILE
)


print()
print(
    f"Complete. Saved {len(all_rows)} records "
    f"to {OUTPUT_FILE}"
)
