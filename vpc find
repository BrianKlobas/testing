#!/usr/bin/env python3

import boto3
from botocore.exceptions import ClientError
from openpyxl import Workbook
from openpyxl.utils import get_column_letter
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime
import threading


# ==========================================================
# Configuration
# ==========================================================

ROLE_NAME = "OrganizationAccountAccessRole"

REGIONS = [
    "us-east-1",
    "us-east-2",
    "ap-south-1",
    "ap-southeast-1",
    "us-west-2",
]

OUTPUT_FILE = "aws_vpc_cidr_inventory.xlsx"

# 50 concurrent AWS operations
MAX_WORKERS = 50


# ==========================================================
# AWS clients
# ==========================================================

session = boto3.Session()

org = session.client("organizations")
sts = session.client("sts")


# ==========================================================
# Thread-safe counters
# ==========================================================

lock = threading.Lock()

completed = 0
total_tasks = 0


# ==========================================================
# Organization
# ==========================================================

def list_accounts():

    paginator = org.get_paginator(
        "list_accounts"
    )

    accounts = []

    for page in paginator.paginate():

        for account in page["Accounts"]:

            if account["Status"] == "ACTIVE":
                accounts.append(account)

    return accounts


# ==========================================================
# Assume Role
# ==========================================================

def assume_role(account_id):

    response = sts.assume_role(
        RoleArn=f"arn:aws:iam::{account_id}:role/{ROLE_NAME}",
        RoleSessionName="VpcInventory",
    )

    creds = response["Credentials"]

    return boto3.Session(
        aws_access_key_id=creds["AccessKeyId"],
        aws_secret_access_key=creds["SecretAccessKey"],
        aws_session_token=creds["SessionToken"],
    )


# ==========================================================
# Helpers
# ==========================================================

def get_name_tag(tags):

    if not tags:
        return ""

    for tag in tags:

        if tag["Key"] == "Name":
            return tag["Value"]

    return ""


# ==========================================================
# Worker
#
# One worker = ONE account + ONE region
# ==========================================================

def scan_account_region(account, acct_session, region):

    global completed

    rows = []

    try:

        ec2 = acct_session.client(
            "ec2",
            region_name=region
        )

        response = ec2.describe_vpcs()

        vpcs = response.get("Vpcs", [])


        for vpc in vpcs:

            vpc_name = get_name_tag(
                vpc.get("Tags")
            )


            # --------------------------------------------------
            # IPv4
            # --------------------------------------------------

            for cidr in vpc.get(
                "CidrBlockAssociationSet",
                []
            ):

                cidr_block = cidr.get(
                    "CidrBlock"
                )

                if cidr_block:

                    rows.append([
                        account["Name"],
                        account["Id"],
                        region,
                        vpc_name,
                        vpc["VpcId"],
                        "IPv4",
                        cidr_block,
                        vpc["State"],
                        vpc["IsDefault"],
                    ])


            # --------------------------------------------------
            # IPv6
            # --------------------------------------------------

            for cidr in vpc.get(
                "Ipv6CidrBlockAssociationSet",
                []
            ):

                ipv6_cidr = cidr.get(
                    "Ipv6CidrBlock"
                )

                if ipv6_cidr:

                    rows.append([
                        account["Name"],
                        account["Id"],
                        region,
                        vpc_name,
                        vpc["VpcId"],
                        "IPv6",
                        ipv6_cidr,
                        vpc["State"],
                        vpc["IsDefault"],
                    ])


    except ClientError as e:

        # Keep errors in the spreadsheet instead of
        # killing the entire scan.

        rows.append([
            account["Name"],
            account["Id"],
            region,
            "",
            "",
            "",
            f"AWS ERROR: {e}",
            "",
            "",
        ])


    except Exception as e:

        rows.append([
            account["Name"],
            account["Id"],
            region,
            "",
            "",
            "",
            f"ERROR: {e}",
            "",
            "",
        ])


    with lock:

        completed += 1

        print(
            f"[{completed}/{total_tasks}] "
            f"{account['Name']} "
            f"({account['Id']}) "
            f"{region}"
        )


    return rows


# ==========================================================
# Main
# ==========================================================

accounts = list_accounts()

TOTAL_ACCOUNTS = len(accounts)

total_tasks = TOTAL_ACCOUNTS * len(REGIONS)

print()
print(
    f"Scanning {TOTAL_ACCOUNTS} accounts "
    f"x {len(REGIONS)} regions "
    f"= {total_tasks} account/region scans"
)

print(
    f"Using {MAX_WORKERS} concurrent workers..."
)

print()


all_rows = []


# ==========================================================
# Assume roles once per account
#
# This avoids doing STS AssumeRole 5 times per account.
# ==========================================================

account_sessions = {}

print("Assuming roles...")

for account in accounts:

    try:

        account_sessions[account["Id"]] = (
            assume_role(account["Id"])
        )

    except Exception as e:

        print(
            f"WARNING: Could not assume role into "
            f"{account['Name']} ({account['Id']}): {e}"
        )

print(
    f"Successfully assumed roles into "
    f"{len(account_sessions)}/{TOTAL_ACCOUNTS} accounts."
)

print()


# ==========================================================
# Build account/region tasks
# ==========================================================

tasks = []

for account in accounts:

    acct_session = account_sessions.get(
        account["Id"]
    )

    if not acct_session:
        continue

    for region in REGIONS:

        tasks.append(
            (
                account,
                acct_session,
                region
            )
        )


total_tasks = len(tasks)


# ==========================================================
# Run concurrent scans
# ==========================================================

with ThreadPoolExecutor(
    max_workers=MAX_WORKERS
) as executor:

    futures = [

        executor.submit(
            scan_account_region,
            account,
            acct_session,
            region
        )

        for account, acct_session, region
        in tasks
    ]


    for future in as_completed(futures):

        try:

            result = future.result()

            all_rows.extend(result)

        except Exception as e:

            print(
                f"Worker failure: {e}"
            )


# ==========================================================
# Write Excel
# ==========================================================

print()
print("Writing Excel...")


wb = Workbook()

ws = wb.active
ws.title = "VPC CIDR Inventory"


headers = [
    "Account Name",
    "Account ID",
    "Region",
    "VPC Name",
    "VPC ID",
    "CIDR Version",
    "CIDR",
    "VPC State",
    "Default VPC",
]


ws.append(headers)


for row in all_rows:

    ws.append(row)


# ==========================================================
# Column widths
# ==========================================================

for column in ws.columns:

    length = max(
        len(str(cell.value))
        if cell.value
        else 0
        for cell in column
    )

    ws.column_dimensions[
        get_column_letter(
            column[0].column
        )
    ].width = length + 3


# ==========================================================
# Metadata
# ==========================================================

meta = wb.create_sheet(
    "Metadata"
)

meta.append([
    "Generated",
    datetime.utcnow().isoformat()
])

meta.append([
    "Accounts Scanned",
    TOTAL_ACCOUNTS
])

meta.append([
    "Account/Region Scans",
    total_tasks
])

meta.append([
    "Successful Role Sessions",
    len(account_sessions)
])

meta.append([
    "Workers",
    MAX_WORKERS
])

meta.append([
    "Regions",
    ",".join(REGIONS)
])


# ==========================================================
# Save
# ==========================================================

wb.save(
    OUTPUT_FILE
)


print()
print(
    f"Complete. Saved {len(all_rows)} records "
    f"to {OUTPUT_FILE}"
)
