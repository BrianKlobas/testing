query {
  issuesV2(first: 100) {
    nodes {
      id
      createdAt
      updatedAt
      status
      severity
      type

      control {
        id
        name
        description
        resolutionRecommendation
      }

      sourceRule {
        id
        name
      }

      entitySnapshot {
        id
        type
        nativeType
        name
        cloudPlatform
        providerId
        externalId
        region
        cloudProviderURL
      }

      project {
        id
        name
        slug
      }
    }

    pageInfo {
      hasNextPage
      endCursor
    }
  }
}
